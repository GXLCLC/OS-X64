# ==================================================================
# LEDE X86_64 固件配置（lean 大雕源码 master 分支）
# 使用方式：直接修改本文件增删插件后手动触发工作流即可
# 说明：个别第三方包的精确符号名以上游 Makefile 为准，不存在的
#       符号会在 make defconfig 时被自动忽略，不会导致报错
# ==================================================================

# ---------------- 目标平台：仅 X86_64 Generic ----------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ---------------- 镜像格式：固定 squashfs ----------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 产物输出为 img.gz 压缩包
CONFIG_TARGET_IMAGES_GZIP=y
# 根分区强制扩容 2G：默认 104MB + 2048MB = 2152MB（按需自行调整）
CONFIG_TARGET_ROOTFS_PARTSIZE=2152
# 生成 GRUB 引导镜像（Legacy BIOS + EFI 双格式）
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y

# ---------------- LuCI 基础 ----------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_firewall4=y

# ---------------- 主题：Argon + Argon 配置器 ----------------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-argon-config=y

# ---------------- 1. SmartDNS ----------------
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# ---------------- 2. DDNS.TO（默认中文） ----------------
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-i18n-ddnsto-zh-cn=y

# ---------------- 3. AdGuard Home（核心程序 + 完整依赖） ----------------
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y

# ---------------- 4. OAF 应用过滤（含 kmod-oaf 内核模块） ----------------
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y

# ---------------- 5. TurboACC（仅流量分载/全锥NAT/BBR） ----------------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_offloading=y    # 软件流量分载
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_bbr_cca=y       # BBR 拥塞控制
CONFIG_PACKAGE_kmod-tcp-bbr=y                            # BBR（官方内核自带模块）
CONFIG_PACKAGE_kmod-nft-fullcone=y                       # 全锥形 NAT（lede 源码内核补丁）
# 依赖冲突策略：显式移除 SFE / Shortcut-FE 外部内核模块，保留官方内核
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_sfe is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_shortcut-fe is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_shortcut-fe-cm is not set

# ---------------- 6. MWAN3 多拨负载均衡 ----------------
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y

# ---------------- 7. 带宽监控 nlbwmon ----------------
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# ---------------- 8. EasyTier 异地组网 ----------------
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y

# ---------------- 9. WOL 网络唤醒 ----------------
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# ---------------- 10. UPnP ----------------
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ---------------- 11. ttyd Web 终端 ----------------
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# ---------------- 12. 定时自动重启 ----------------
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y

# ---------------- 13. 微信推送 ----------------
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y
CONFIG_PACKAGE_bash=y

# ---------------- 常用网卡驱动（内核模块与本机编译内核严格匹配） ----------------
# 板载千兆：Intel i211/i210（igb）、RTL8111（r8169）及常见 e1000e/igc
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-r8169=y

# ---------------- USB 网卡驱动 ----------------
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-lan78xx=y

# ---------------- USB 存储与文件系统 ----------------
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb2-pci=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# ---------------- 常用基础组件 ----------------
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
