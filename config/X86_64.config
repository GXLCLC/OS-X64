#
# =============================================================================
# config/X86_64.config —— LEDE X86_64 Generic 编译配置（coolsnowwolf/lede master）
#
# 本文件由工作流拷贝为源码树 .config，并由 scripts/check-packages.sh 与
# config/required-packages.txt 双向校验。所有符号均按 2026-10-20 对 LEDE
# master 实测核对（内核 6.18.55；feeds：luci openwrt-25.12 / packages master）。
# 增删插件只需修改本文件，check-packages.sh 会自动核对一致性。
#
# 编译目标：X86_64 Generic + squashfs（用户规范：仅此一个目标、一种根文件系统）
# =============================================================================
#

#
# ---- 1. 目标平台与根文件系统 ------------------------------------------------
#
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 仅编译 squashfs 一种根文件系统（用户规范），显式关闭其余形态
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_JFFS2 is not set
# CONFIG_TARGET_ROOTFS_EROFS is not set

#
# ---- 2. 分区与镜像形态 ------------------------------------------------------
#
# 强制根分区扩容 2G（用户规范；x86 默认仅 448 MiB）
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
# 镜像不内置 gzip：combined.img = 64 MiB 内核分区 + 2048 MiB 根分区 ≈ 2112 MiB，
# 超过 GitHub Release 单文件 2 GiB 上限；工作流改为校验原始 .img 后手动 gzip -9
# CONFIG_TARGET_IMAGES_GZIP is not set
# GRUB 镜像开关默认为 n（config/Config-images.in），必须显式开启：
#   combined.img     —— MBR + GRUB，兼容 BIOS 与带 CSM 的传统 UEFI 机器
#   combined-efi.img —— GPT + GRUB EFI，兼容纯 UEFI 新机器（N100 小主机等）
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
# 仅编译 X86_64Generic + squashfs，显式关闭其余镜像形态（用户规范）
# CONFIG_ISO_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set

#
# ---- 3. LuCI 基础与防火墙 ---------------------------------------------------
#
# collections/luci 元包 = luci-light（luci-base + uhttpd + luci-mod-admin-full
# + luci-app-firewall 等）+ luci-app-package-manager，提供完整 LuCI 网页管理
CONFIG_PACKAGE_luci=y
# firewall4（nftables）；流量分载 / 全锥形 NAT / UPnP 均基于 fw4
CONFIG_PACKAGE_firewall4=y
# CONFIG_PACKAGE_firewall is not set
# rpcd 的 ucode 后端插件：luci-app-turboacc（mufeng05 custom 层）与
# luci-app-upnp 的 rpcd 接口均为 ucode 脚本，必须开启
# （package/system/rpcd 的 BuildPlugin ucode 为独立插件）
CONFIG_PACKAGE_rpcd-mod-ucode=y

#
# ---- 4. 预装插件（15 个，用户规范）+ 各自核心 -------------------------------
#      命名说明（2026-10-20 实测）：
#       · luci-theme-argon-config 官方现名为 luci-app-argon-config
#         （luci feed applications/luci-app-argon-config，功能相同）；
#       · luci-app-easytier 官方现名为 luci-app-easytier-next，核心为
#         packages feed 的 easytier-next（2.6.4 预编译二进制，与源码编译的
#         旧 easytier 包 CONFLICTS 二选一；按「优先官方源码包」取官方成套）；
#       · luci-app-upnp 在 fw4 下依赖 miniupnpd-nftables（非 miniupnpd）。
#
# (1) SmartDNS（luci feed + packages feed net/smartdns 47.1）
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y
# (2) DDNSTO（kenzok8/openwrt-packages，官方 feed 无此插件；控制器默认中文）
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_ddnsto=y
# (3) AdGuardHome（luci feed + packages feed net/adguardhome 0.107.79，含核心）
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y
# (4) OpenAppFilter（destan19/OpenAppFilter master 7.0.x 成套，覆盖官方 6.1.4）
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y
# (5) TurboAcc（mufeng05/turboacc 版覆盖官方 feed 旧版；仅流量分载/全锥/BBR）
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_FULLCONE=y
# CONFIG_PACKAGE_TURBOACC_INCLUDE_FAST_CLASSIFIER is not set
# CONFIG_PACKAGE_TURBOACC_INCLUDE_SHORTCUT_FE_CM is not set
# CONFIG_PACKAGE_TURBOACC_INCLUDE_NO_FASTPATH is not set
# (6) MWAN3 多线负载均衡
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3=y
# (7)(8) Argon 主题（默认主题，由 personalize.sh 写 luci.main.mediaurlbase）
#        + Argon 主题配置界面
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
# (9) 网络负载监视 nlbwmon
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_nlbwmon=y
# (10) EasyTier 去中心化组网（官方 easytier-next 成套）
CONFIG_PACKAGE_luci-app-easytier-next=y
CONFIG_PACKAGE_easytier-next=y
# EasyTier Web 控制台默认 y；LuCI 已提供完整管理界面，按纯净原则关闭
# CONFIG_PACKAGE_EASYTIER_INCLUDE_WEBCONSOLE is not set
# (11) 网络唤醒 Wake-on-LAN（luci-app-wol 依赖 etherwake）
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y
# (12) UPnP（fw4 下为 miniupnpd-nftables 2.3.9）
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
# (13) 网页终端 TTYD
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
# (14) 定时重启
CONFIG_PACKAGE_luci-app-autoreboot=y
# (15) 微信推送（依赖 curl/jq/bash 等由构建系统自动拉取）
CONFIG_PACKAGE_luci-app-wechatpush=y

#
# ---- 5. 有线网卡驱动（用户规范：i211 / RTL8111 及常见 Intel/Realtek/Atheros）
#      注意：官方与第三方源均无 kmod-r8168；RTL8111 由主线 kmod-r8169 完整
#      支持（6.18 内核），且规范禁引外部 kmod，故使用官方 kmod-r8169。
#
CONFIG_PACKAGE_kmod-igb=y        # Intel I210/I211（i211 主力驱动）
CONFIG_PACKAGE_kmod-igc=y        # Intel I225/I226（2.5GbE）
CONFIG_PACKAGE_kmod-e1000e=y     # Intel PCIe 千兆
CONFIG_PACKAGE_kmod-r8169=y      # Realtek RTL8111/8168 系列
CONFIG_PACKAGE_kmod-alx=y        # Atheros AR8161/8162 等
CONFIG_PACKAGE_kmod-atl1=y       # Atheros L1 千兆
CONFIG_PACKAGE_kmod-atl2=y       # Atheros L2 千兆

#
# ---- 6. USB 网卡驱动 ---------------------------------------------------------
#      x86 内核已内置 USB 主控（EHCI/OHCI/UHCI/xHCI PCI）与 usbcore
#      （target/linux/x86/config-6.18），无需 kmod-usb-core/usb2/usb3；
#      以下均为模块化设备驱动。
#
CONFIG_PACKAGE_kmod-usb-net=y                  # USB 网卡核心（usbnet）
CONFIG_PACKAGE_kmod-usb-net-asix=y             # ASIX USB2 网卡
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y     # ASIX AX88179 USB3 网卡
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y        # CDC-ECM（USB 网络共享通用）
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y          # CDC-NCM（Huawei 等）
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y         # MBIM 4G/5G 模块
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y         # QMI 4G/5G 模块
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-net-r8152=y            # Realtek USB3 网卡（主力）
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y          # Realtek USB2 网卡
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y         # SMSC LAN9500 USB2
CONFIG_PACKAGE_kmod-usb-net-smsc75xx=y         # SMSC LAN75xx USB3
CONFIG_PACKAGE_kmod-usb-net-lan78xx=y          # SMSC LAN7800 USB3
CONFIG_PACKAGE_kmod-usb-net-dm9601-ether=y     # DM9601 USB 网卡
CONFIG_PACKAGE_kmod-usb-net-mcs7830=y          # MCS7830 USB 网卡
CONFIG_PACKAGE_kmod-usb-net-pegasus=y          # Pegasus USB 网卡
CONFIG_PACKAGE_kmod-usb-net-kaweth=y           # USB 网络共享（旧）
CONFIG_PACKAGE_kmod-usb-net-ipheth=y           # iPhone USB 网络共享
CONFIG_PACKAGE_kmod-usb-net-hso=y
CONFIG_PACKAGE_kmod-usb-net-kalmia=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y            # RNDIS（Android/Windows 共享）
CONFIG_PACKAGE_kmod-usb-net-sr9700=y
CONFIG_PACKAGE_kmod-usb-net-pl=y
# 4G/5G 上网卡与 USB 串口设备
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y

#
# ---- 7. USB 存储与文件系统 ---------------------------------------------------
#      x86 内核已内置 SCSI/ATA（含 SATA）与 EXT4/F2FS
#      （target/linux/x86/config-6.18），无需选对应 kmod；
#      以下为 USB 大容量存储与可移动介质文件系统。
#
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y          # USB3 UAS 协议
CONFIG_PACKAGE_kmod-fs-vfat=y                   # FAT16/FAT32（U 盘通用）
CONFIG_PACKAGE_kmod-fs-exfat=y                  # exFAT
CONFIG_PACKAGE_kmod-fs-ntfs3=y                  # NTFS（内核原生 ntfs3）

#
# ---- 8. 其他必要组件 ---------------------------------------------------------
#
# TUN/TAP：EasyTier 虚拟网卡依赖（easytier-next DEPENDS +kmod-tun 会自动拉取，
# 此处显式声明便于维护与校验）
CONFIG_PACKAGE_kmod-tun=y
